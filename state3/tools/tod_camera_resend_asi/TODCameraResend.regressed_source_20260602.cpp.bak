// Candidate roles, keyed purely on observed draw behavior (no game content is
// hardcoded). The discriminator that separates the menu from the in-game HUD is
// frame ordering: menu/fullscreen UI is drawn before any 3D world geometry in the
// frame, whereas the in-game HUD is the screen-space layer drawn after the world.
constexpr DWORD kCandidateRoleUi = 1u << 0;        // RHW screen-space, before world
constexpr DWORD kCandidateRoleVideo = 1u << 1;     // large one-mip A8 screen-space
constexpr DWORD kCandidateRoleWorldUnshadowed = 1u << 2;
constexpr DWORD kCandidateRoleHud = 1u << 3;       // RHW screen-space, after world
constexpr DWORD kCandidateRoleEffect = 1u << 4;    // fixed-function overlay sprites
constexpr DWORD kCandidateRoleWorld = 1u << 5;     // 3D fixed-function world geometry
constexpr LONG kMaxTextureCandidateDumps = 2048;

constexpr DWORD kDdsdCaps = 0x00000001u;
