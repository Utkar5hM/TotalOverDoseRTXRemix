constexpr DWORD kDevicePresentIndex = 17;
constexpr DWORD kDeviceCreateTextureIndex = 23;
constexpr DWORD kDeviceCreateRenderTargetIndex = 28;
constexpr DWORD kDeviceStretchRectIndex = 34;
constexpr DWORD kDeviceSetRenderTargetIndex = 37;
constexpr DWORD kDeviceSetDepthStencilSurfaceIndex = 39;
constexpr DWORD kDeviceSetTransformIndex = 44;
constexpr DWORD kDeviceSetRenderStateIndex = 57;
constexpr DWORD kDeviceSetTextureIndex = 65;
constexpr DWORD kDeviceDrawPrimitiveIndex = 81;
constexpr DWORD kDeviceDrawIndexedPrimitiveIndex = 82;
constexpr DWORD kDeviceDrawPrimitiveUPIndex = 83;
constexpr DWORD kDeviceDrawIndexedPrimitiveUPIndex = 84;
constexpr DWORD kDeviceCreateVertexDeclarationIndex = 86;
constexpr DWORD kDeviceSetVertexDeclarationIndex = 87;
constexpr DWORD kDeviceSetFVFIndex = 89;
constexpr DWORD kDeviceSetVertexShaderIndex = 92;

// Feature toggles. These encode settled decisions from the debug log; they are
// kept as named constants so each behavior is greppable and individually
// reversible during regression testing rather than buried in conditions.

// Render-target handling (subsystem 2). The "all color RT" + "skip all RT
// composites" pair is what removed the "non-primary render target" warning.
constexpr bool kRedirectFullSizeSceneRtToPrimary = true;
constexpr bool kSkipRtTextureCompositesToPrimary = true;
constexpr bool kRedirectAllColorRtTexturesToPrimary = true;
constexpr bool kSkipAllRtTextureComposites = true;
// Behavior-marked UI render targets: allow a small offscreen RT to be treated as
// a UI layer once the game draws screen-space UI into it. Full-size scene RTs are
// never promoted this way (that would reopen the original black-screen path).
constexpr bool kAllowBehaviorMarkedUiRenderTargets = true;
constexpr bool kPromoteFullSizeBehaviorMarkedUiRenderTargets = false;
// Managed texture handling (subsystem 3). PreLoad was proven insufficient and is
// left disabled as a diagnostic switch; SYSTEMMEM->DEFAULT shadowing is the path
// that actually gives Remix valid hashes.
constexpr bool kPreloadManagedTexturesBeforeBind = false;
constexpr bool kBindDefaultCopiesForManagedTextures = true;
constexpr bool kShadowAllSupportedManagedTextures = true;
// Candidate discovery (subsystem 4) is diagnostic scaffolding, not part of the
// shim's runtime job: it classifies textures by draw behavior and emits a TSV +
// DDS dumps so real atlas hashes can be identified offline and placed in the
// Remix config (rtx.uiTextures / rtx.hideInstanceTextures). No hash ever lives
// in this binary. Flip this to false for a shipping build and the whole harness
// compiles out, leaving only the three runtime subsystems above.
constexpr bool kEnableCandidateDiscovery = true;

constexpr DWORD kTextureReleaseIndex = 2;
constexpr DWORD kTextureLockRectIndex = 19;
constexpr DWORD kTextureUnlockRectIndex = 20;
constexpr DWORD kTextureAddDirtyRectIndex = 21;
constexpr DWORD kTrackedTextureStages = 8;
constexpr DWORD kMaxConfiguredUiTextureHashes = 512;
// Safety cap on the diagnostic log. Long sessions with millions of draws can
// otherwise grow it to hundreds of MB. Once reached, one final notice is written
// and further lines are dropped.
constexpr LONG kMaxLogBytes = 128 * 1024 * 1024;

