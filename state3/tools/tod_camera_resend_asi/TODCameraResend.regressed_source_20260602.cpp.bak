    const RECT* destRect,
    HWND destWindowOverride,
    const RGNDATA* dirtyRegion);
using SetTransformFn = HRESULT(APIENTRY*)(
    IDirect3DDevice9* self,
    D3DTRANSFORMSTATETYPE state,
    const D3DMATRIX* matrix);
using CreateTextureFn = HRESULT(APIENTRY*)(
    IDirect3DDevice9* self,
    UINT width,
    UINT height,
    UINT levels,
    DWORD usage,
    D3DFORMAT format,
